a-hidden=\"true\"><path d=\"m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7\"></path><rect x=\"2\" y=\"4\" width=\"20\" height=\"16\" rx=\"2\"></rect></svg></span><span class=\"rounded px-1.5 py-0.5 text-xs text-fg-2 bg-blush\">Email</span></a><a href=\"https://chatblix.com\" target=\"_blank\" rel=\"noreferrer\" class=\"group absolute flex -translate-x-1/2 items-center gap-1.5 bottom-[6%] flex-col-reverse\" style=\"left:83%\"><span class=\"flex h-11 w-11 items-center justify-center rounded-full border border-line-strong bg-card text-fg-2 transition-all group-hover:-rotate-6 group-hover:border-accent group-hover:text-accent\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-layers h-5 w-5\" aria-hidden=\"true\"><path d=\"M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z\"></path><path d=\"M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12\"></path><path d=\"M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17\"></path></svg></span><span class=\"rounded px-1.5 py-0.5 text-xs text-fg-2 bg-sage\">Chatblix</span></a><div class=\"absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2\"><div class=\"rounded-full border-2 border-dashed border-accent bg-card p-1\"><img alt=\"Milap Magar\" width=\"60\" height=\"60\" decoding=\"async\" data-nimg=\"1\" class=\"rounded-full object-cover \" style=\"color:transparent;width:60px;height:60px;object-position:50% 70%\" srcSet=\"/_next/image?url=%2Fmilap.png&amp;w=64&amp;q=75 1x, /_next/image?url=%2Fmilap.png&amp;w=128&amp;q=75 2x\" src=\"/_next/image?url=%2Fmilap.png&amp;w=128&amp;q=75\"/></div></div><span class=\"absolute right-[63%] top-1/2 -translate-y-1/2 whitespace-nowrap font-display text-lg text-fg\">me</span></div></div></div><div style=\"opacity:0;transform:translateY(18px)\"><figure class=\"relative mx-2 rotate-[1.2deg] bg-butter px-6 pb-6 pt-8 shadow-[2px_6px_0_rgba(158,125,70,0.18)]\"><span class=\"tape -top-3 left-1/2 -translate-x-1/2 -rotate-3 bg-[rgba(251,245,232,0.7)]\"></span><blockquote class=\"font-display text-[1.4rem] leading-snug text-[#4a3a1c]\">“<!-- -->Good software is a conversation — design asks the question, engineering answers it, and the user shouldn&#x27;t notice either.<!-- -->”</blockquote><figcaption class=\"mt-5 text-right italic text-[#6f5a30]\">— a note on my monitor</figcaption></figure></div><div style=\"opacity:0;transform:translateY(18px)\"><div class=\"card p-5\"><h3 class=\"font-display text-[1.45rem] leading-tight text-fg\">Things I reach for</h3><p class=\"mt-1 text-sm italic text-fg-3\">in no particular order, except Figma first.</p><div class=\"mt-4 flex flex-wrap gap-2\"><span class=\"rounded-md border border-line-strong bg-card px-2.5 py-1 text-sm text-fg-2 \">Figma</span><span class=\"rounded-md border border-line-strong bg-card px-2.5 py-1 text-sm text-fg-2 rotate-1\">React</span><span class=\"rounded-md border border-line-strong bg-card px-2.5 py-1 text-sm text-fg-2 \">Next.js</span><span class=\"rounded-md border border-line-strong bg-card px-2.5 py-1 text-sm text-fg-2 -rotate-1\">TypeScript</span><span class=\"rounded-md border border-line-strong bg-card px-2.5 py-1 text-sm text-fg-2 \">Tailwind</span><span class=\"rounded-md border border-line-strong bg-card px-2.5 py-1 text-sm text-fg-2 rotate-1\">Framer Motion</span><span class=\"rounded-md border border-line-strong bg-card px-2.5 py-1 text-sm text-fg-2 \">Node.js</span><span class=\"rounded-md border border-line-strong bg-card px-2.5 py-1 text-sm text-fg-2 -rotate-1\">Java</span><span class=\"rounded-md border border-line-strong bg-card px-2.5 py-1 text-sm text-fg-2 \">PostgreSQL</span><span class=\"rounded-md border border-line-strong bg-card px-2.5 py-1 text-sm text-fg-2 rotate-1\">MongoDB</span><span class=\"rounded-md border border-line-strong bg-card px-2.5 py-1 text-sm text-fg-2 \">Supabase</span><span class=\"rounded-md border border-line-strong bg-card px-2.5 py-1 text-sm text-fg-2 -rotate-1\">Docker</span></div></div></div><div style=\"opacity:0;transform:translateY(18px)\"><a href=\"https://shark-payment.vercel.app\" target=\"_blank\" rel=\"noreferrer\" class=\"card group block p-5\"><div class=\"flex items-start justify-between gap-3\"><h3 class=\"font-display text-[1.45rem] leading-tight text-fg\">Sharky Payment</h3><span class=\"flex items-center gap-2 pt-1\"><span class=\"rounded-full border border-dashed border-accent px-2 py-0.5 text-xs italic text-accent\">still cooking</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-up-right h-5 w-5 text-fg-3 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent\" aria-hidden=\"true\"><path d=\"M7 7h10v10\"></path><path d=\"M7 17 17 7\"></path></svg></span></div><p class=\"mt-1.5 text-[0.95rem] leading-relaxed text-fg-2\">Online payments and secure, authenticated transactions.</p><div class=\"relative mt-5\"><span class=\"tape -top-2.5 -left-3 -rotate-[24deg]\"></span><div class=\"overflow-hidden rounded-md border border-line-strong bg-paper-2 p-1.5\"><img alt=\"Sharky Payment screenshot\" loading=\"lazy\" width=\"1200\" height=\"750\" decoding=\"async\" data-nimg=\"1\" class=\"aspect-[16/10] w-full rounded-[3px] object-cover object-top saturate-[0.85] sepia-[0.08] transition-[filter] duration-500 group-hover:saturate-100 group-hover:sepia-0\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2FProject-Showcase%2Fsharky.png&amp;w=1200&amp;q=75 1x, /_next/image?url=%2FProject-Showcase%2Fsharky.png&amp;w=3840&amp;q=75 2x\" src=\"/_next/image?url=%2FProject-Showcase%2Fsharky.png&amp;w=3840&amp;q=75\"/></div></div><div class=\"mt-4 flex flex-wrap gap-1.5\"><span class=\"rounded-md border border-line bg-paper-2/60 px-2 py-0.5 text-xs text-fg-2\">Next.js</span><span class=\"rounded-md border border-line bg-paper-2/60 px-2 py-0.5 text-xs text-fg-2\">TypeScript</span><span class=\"rounded-md border border-line bg-paper-2/60 px-2 py-0.5 text-xs text-fg-2\">Tailwind</span></div></a></div><div style=\"opacity:0;transform:translateY(18px)\"><div class=\"card p-5\"><h3 class=\"font-display text-[1.45rem] leading-tight text-fg\">Where my hours go</h3><div class=\"mt-5 flex h-14 overflow-hidden rounded-md border border-line-strong\"><div class=\"flex items-center justify-center \" style=\"width:30%;background:#efd9a0\"><span class=\"font-display text-xl text-fg\">30<!-- -->%</span></div><div class=\"flex items-center justify-center border-l border-dashed border-line-strong\" style=\"width:45%;background:#e8c3ad\"><span class=\"font-display text-xl text-fg\">45<!-- -->%</span></div><div class=\"flex items-center justify-center border-l border-dashed border-line-strong\" style=\"width:25%;background:#cfd6ad\"><span class=\"font-display text-xl text-fg\">25<!-- -->%</span></div></div><div class=\"mt-2 flex\"><span style=\"width:30%\" class=\"text-center text-sm italic text-fg-2\">Design</span><span style=\"width:45%\" class=\"text-center text-sm italic text-fg-2\">Frontend</span><span style=\"width:25%\" class=\"text-center text-sm italic text-fg-2\">Backend</span></div></div></div></div></div><div class=\"mt-12\"><div class=\"px-2 pb-4 pt-2 text-center\"><p class=\"font-display text-2xl text-fg\">That&#x27;s most of it.</p><svg viewBox=\"0 0 240 14\" preserveAspectRatio=\"none\" class=\"mx-auto mt-1 h-3 w-40 text-accent\" aria-hidden=\"true\"><path d=\"M3 9 C 28 3, 52 12, 80 7 S 132 3, 160 8 S 212 11, 237 5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\"></path></svg><p class=\"mt-3 text-[0.95rem] italic text-fg-2\">Got something half-built or not yet started? <br/><a href=\"mailto:info@milapmagar.com.np\" class=\"text-accent underline underline-offset-4\">Tell me about it</a>. I read everything.</p></div></div></main></div><!--$--><!--/$--><script src=\"/_next/static/chunks/webpack-47e3cf0d2be5e61c.js\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[3895,[],\\\"\\\"]\\n3:I[7835,[],\\\"\\\"]\\n5:I[581,[],\\\"OutletBoundary\\\"]\\n8:I[755,[],\\\"AsyncMetadataOutlet\\\"]\\na:I[581,[],\\\"ViewportBoundary\\\"]\\nc:I[581,[],\\\"MetadataBoundary\\\"]\\ne:I[4850,[],\\\"\\\"]\\n:HL[\\\"/_next/static/media/110cbef534704ef8-s.p.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/media/3b011bc2a961fce0-s.p.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/media/5c0c2bcbaa4149ca-s.p.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/css/18c3e23239d14043.css\\\",\\\"style\\\"]\\n\"])</script><script>self.__next_f.push([1,\"0:{\\\"P\\\":null,\\\"b\\\":\\\"CKa7Q1UxTxJqkezXTSGoA\\\",\\\"p\\\":\\\"\\\",\\\"c\\\":[\\\"\\\",\\\"\\\"],\\\"i\\\":false,\\\"f\\\":[[[\\\"\\\",{\\\"children\\\":[\\\"__PAGE__\\\",{}]},\\\"$undefined\\\",\\\"$undefined\\\",true],[\\\"\\\",[\\\"$\\\",\\\"$1\\\",\\\"c\\\",{\\\"children\\\":[[[\\\"$\\\",\\\"link\\\",\\\"0\\\",{\\\"rel\\\":\\\"stylesheet\\\",\\\"href\\\":\\\"/_next/static/css/18c3e23239d14043.css\\\",\\\"precedence\\\":\\\"next\\\",\\\"crossOrigin\\\":\\\"$undefined\\\",\\\"nonce\\\":\\\"$undefined\\\"}]],[\\\"$\\\",\\\"html\\\",null,{\\\"lang\\\":\\\"en\\\",\\\"className\\\":\\\"__variable_aef521 __variable_470c6f\\\",\\\"children\\\":[\\\"$\\\",\\\"body\\\",null,{\\\"className\\\":\\\"antialiased\\\",\\\"children\\\":[\\\"$\\\",\\\"$L2\\\",null,{\\\"parallelRouterKey\\\":\\\"children\\\",\\\"error\\\":\\\"